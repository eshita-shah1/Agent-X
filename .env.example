# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agentx_app
DB_PASSWORD=change-me
DB_NAME=agentx
DB_TEST_NAME=agentx_test

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-x
# Development placeholder; token lifetime is a deployment setting, not a product decision.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host port for the API container (docker compose).
API_PORT=8000
