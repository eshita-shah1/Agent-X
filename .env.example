# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agentx_app
DB_PASSWORD=change-me
DB_NAME=agentx
DB_TEST_NAME=agentx_test

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-x
# Development placeholder; token lifetime is a deployment setting, not a product decision.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host port for the API container (docker compose).
API_PORT=8000

# --- Market data (Phase 2). All optional; defaults shown. ---
# MARKETDATA_PROVIDER=yahoo
# PROVISIONAL (descriptive, not a trading-risk rule): a bar is archived once observed_at >= bar_end + this margin
# MARKETDATA_FINALIZATION_MARGIN_SECONDS=60
# PROVISIONAL, descriptive only in Phase 2; not guaranteed Yahoo behaviour
# MARKETDATA_STALE_AFTER_MINUTES=15
# MARKETDATA_PROVIDER_UNAVAILABLE_AFTER_FAILURES=3
# Operational
# MARKETDATA_INCREMENTAL_OVERLAP_HOURS=24
# MARKETDATA_JOB_HEARTBEAT_TIMEOUT_SECONDS=300
# MARKETDATA_REQUEST_PAUSE_SECONDS=1.5

# ---- Phase 4: execution price gate (open decision D4) -----------------------------------
# Fail-closed by default: with these values the Mock Exchange fills NOTHING. Enabling fills
# is an explicit owner decision (see docs/PHASE4.md). Never approve UNVERIFIED_PROVIDER_NATIVE
# (the application refuses to start if you do).
# disabled | verified_next_bar_open | simulation_provider_native (Yahoo; see docs/D4_EXECUTION_READINESS.md).
# Any enabled mode refuses to start without an approval reference, exactly one provider, a basis list matching
# the mode (empty for simulation) and all nine cost settings (not all zero).
EXECUTION_MODE=disabled
# EXECUTION_APPROVAL_REFERENCE=             # owner approval id + date, required to enable any mode
EXECUTION_APPROVED_PRICE_BASES=[]          # verified mode only, e.g. ["AS_TRADED_VERIFIED"]; must stay [] for simulation
EXECUTION_APPROVED_PROVIDERS=[]            # JSON list with exactly one provider code, e.g. ["yahoo"]
EXECUTION_CANDLE_TIMEFRAME=5m              # 1m, 5m or 15m (aligned to the 09:15 IST open)
# PROVISIONAL (PRD 7.4): 15-minute stale threshold for the reference price.
EXECUTION_MAX_PRICE_AGE_SECONDS=900

# ---- Phase 4: transaction costs (app/exchange/costs.py) ---------------------------------
# Effective-dated, product-aware cost schedule (JSON) maintained by the operator; see
# docs/cost_schedule.template.json for the format. No rate ships with the code. Execution is refused
# while the schedule is missing/invalid or has no rate for a transaction's product, side and date.
# EXCHANGE_COST_SCHEDULE_PATH=
EXCHANGE_PRODUCT=DELIVERY                  # only DELIVERY is executed (no intraday square-off)
# Optional liquidity cap in (0, 1]: max fraction of a bar's volume per fill.
# Unset = full fills; set = partial fills become possible.
# EXCHANGE_MAX_VOLUME_PARTICIPATION=

# ---- Phase 6: optional LLM narratives (docs/PHASE6.md) -----------------------------------
# Disabled by default: explanations are then deterministic and rule-based, built only from stored records.
# An LLM only rewords verified facts; it can never place, change or cancel anything. No provider is mandatory.
# disabled | openai_compatible (e.g. a local Ollama/LM Studio: free, no key) | anthropic (optional `pip install anthropic`)
LLM_PROVIDER=disabled
# LLM_MODEL=                                # required for openai_compatible; anthropic defaults to claude-opus-5-5
# LLM_BASE_URL=http://127.0.0.1:11434/v1    # openai_compatible: the server's /v1 base URL
# LLM_API_KEY=                              # anthropic: required; openai_compatible: only if the server needs one
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1                         # timeouts, 429 and 5xx only
# LLM_MAX_OUTPUT_TOKENS=4000
# LLM_MAX_REQUESTS_PER_USER_PER_HOUR=30     # beyond it explanations stay rule-based (0 = never call an LLM)
# LLM_INCLUDE_JOURNAL_NOTES=false           # your private notes are sent to a provider only when true

# ---- Phase 8: HTTP hardening and deployment safety (docs/SECURITY.md, docs/DEPLOYMENT.md) ----------
# ENVIRONMENT: development | test | staging | production. production refuses to start with weak secrets
# (JWT_SECRET_KEY >= 48 random chars, DB_PASSWORD >= 16), a test/staging DB_NAME, docs on, wildcard CORS or open ingestion.
# CORS_ALLOW_ORIGINS=[]                      # JSON list of https:// origins; empty = same-origin via the reverse proxy
# ENABLE_API_DOCS=                           # default: on in development/test, off in staging/production
# MAX_REQUEST_BODY_BYTES=1048576
# LOGIN_MAX_FAILURES=5                       # failed logins per email within the window -> 429
# LOGIN_FAILURE_WINDOW_MINUTES=15
# INGESTION_REQUIRES_OPERATOR=               # default: false in development/test, true in staging/production
# TRUSTED_PROXY_IPS=127.0.0.1                # addresses whose X-Forwarded-* headers uvicorn trusts (Docker image)
# PG_BIN_DIR=                                # pg_dump/pg_restore location for the backup tooling if not on PATH
# AGENTX_MIGRATION_TARGET=                   # staging/production: must equal DB_NAME for alembic to run
