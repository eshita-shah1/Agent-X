# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agentx_app
DB_PASSWORD=change-me
DB_NAME=agentx
DB_TEST_NAME=agentx_test

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=agent-x
# Development placeholder; token lifetime is a deployment setting, not a product decision.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host port for the API container (docker compose).
API_PORT=8000

# --- Market data (Phase 2). All optional; defaults shown. ---
# MARKETDATA_PROVIDER=yahoo
# PROVISIONAL (descriptive, not a trading-risk rule): a bar is archived once observed_at >= bar_end + this margin
# MARKETDATA_FINALIZATION_MARGIN_SECONDS=60
# PROVISIONAL, descriptive only in Phase 2; not guaranteed Yahoo behaviour
# MARKETDATA_STALE_AFTER_MINUTES=15
# MARKETDATA_PROVIDER_UNAVAILABLE_AFTER_FAILURES=3
# Operational
# MARKETDATA_INCREMENTAL_OVERLAP_HOURS=24
# MARKETDATA_JOB_HEARTBEAT_TIMEOUT_SECONDS=300
# MARKETDATA_REQUEST_PAUSE_SECONDS=1.5

# ---- Phase 4: execution price gate (open decision D4) -----------------------------------
# Fail-closed by default: with these values the Mock Exchange fills NOTHING. Enabling fills
# is an explicit owner decision (see docs/PHASE4.md). Never approve UNVERIFIED_PROVIDER_NATIVE
# (the application refuses to start if you do).
EXECUTION_PRICE_SOURCE=disabled            # disabled | next_bar_open
EXECUTION_APPROVED_PRICE_BASES=[]          # JSON list, e.g. ["AS_TRADED_VERIFIED"]
EXECUTION_APPROVED_PROVIDERS=[]            # JSON list with exactly one provider code
EXECUTION_CANDLE_TIMEFRAME=5m              # intraday only
# PROVISIONAL (PRD 7.4): 15-minute stale threshold for the reference price.
EXECUTION_MAX_PRICE_AGE_SECONDS=900

# ---- Phase 4: Indian-equity cost model (app/exchange/costs.py) ---------------------------
# No defaults: every rate depends on product (intraday/delivery), broker and date and is an
# owner decision. While any of the nine is unset, orders are rejected with
# COSTS_NOT_CONFIGURED (zero cost is never assumed; 0 is allowed only when set explicitly).
# brokerage = min(BROKERAGE_BPS x turnover, BROKERAGE_MAX_PER_ORDER); GST applies to
# brokerage + transaction charges + SEBI fee. Stamp duty is BUY side only.
# EXCHANGE_BROKERAGE_BPS=
# EXCHANGE_BROKERAGE_MAX_PER_ORDER=
# EXCHANGE_STT_BUY_BPS=
# EXCHANGE_STT_SELL_BPS=
# EXCHANGE_TXN_CHARGE_BPS=
# EXCHANGE_SEBI_FEE_BPS=
# EXCHANGE_STAMP_DUTY_BUY_BPS=
# EXCHANGE_GST_PCT=
# EXCHANGE_SLIPPAGE_BPS=
# Optional liquidity cap in (0, 1]: max fraction of a bar's volume per fill.
# Unset = full fills; set = partial fills become possible.
# EXCHANGE_MAX_VOLUME_PARTICIPATION=
