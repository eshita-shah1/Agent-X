{
  // One window for the whole project: backend, frontend, docs, Docker, migrations and tests.
  // Open with: File > Open Workspace from File... > Agent-X.code-workspace (or `code Agent-X.code-workspace`).
  "folders": [
    { "name": "Agent-X", "path": "." }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/*.tsbuildinfo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.venv": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.venv/**": true,
      "**/dist/**": true
    },
    "files.eol": "\n",
    // Backend (Python): the virtual environment lives at the repository root; tests run from backend/.
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.cwd": "${workspaceFolder}/backend",
    "python.testing.pytestArgs": ["."],
    "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
    // Frontend (TypeScript): use the project's own TypeScript version.
    "typescript.tsdk": "frontend/node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-azuretools.vscode-docker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "backend: api (uvicorn, port 8000)",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python -m uvicorn --factory app.main:build_app --reload --port 8000",
        "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn --factory app.main:build_app --reload --port 8000" },
        "options": { "cwd": "${workspaceFolder}/backend" },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "backend: tests",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python -m pytest -q",
        "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q" },
        "options": { "cwd": "${workspaceFolder}/backend" },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "backend: migrate (alembic upgrade head)",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python -m alembic upgrade head",
        "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m alembic upgrade head" },
        "options": { "cwd": "${workspaceFolder}/backend" },
        "problemMatcher": []
      },
      {
        "label": "frontend: install (npm ci)",
        "type": "shell",
        "command": "npm ci",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "problemMatcher": []
      },
      {
        "label": "frontend: dev (vite, port 5173)",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "frontend: build",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "build",
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "dev: backend + frontend",
        "dependsOn": ["backend: api (uvicorn, port 8000)", "frontend: dev (vite, port 5173)"],
        "problemMatcher": []
      }
    ]
  }
}
