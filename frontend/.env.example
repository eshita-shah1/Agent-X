# Copy to frontend/.env.local (git-ignored) to override.
# The UI currently runs on mock data (src/data); nothing here is required to start it.
# Backend URL the Vite dev server proxies /api and /health to. The FastAPI backend has no CORS middleware, so
# the browser must reach it through this same-origin proxy in development.
VITE_API_PROXY_TARGET=http://localhost:8000
